# Generic ESP32-C3 IoT Node - build defaults.
#
# Secrets (WiFi / MQTT credentials) are NEVER stored here.
# Set them with `idf.py menuconfig` -> "Generic IoT Node" (stored in sdkconfig, git-ignored).

CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TLS certificate bundle is required for HTTPS firmware download (OTA).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# No plain (unencrypted) secrets in the image logging.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y